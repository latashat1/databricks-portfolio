{
  "datasets": [
    {
      "name": "d04c40fe",
      "displayName": "claims_cost_trends",
      "queryLines": [
        "SELECT * FROM main.healthcare_claims_util.gold_claims_cost_trends"
      ]
    },
    {
      "name": "0244ec4d",
      "displayName": "chronic_disease_prevalence",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  main.healthcare_claims_util.gold_chronic_disease_prevalence\n",
        "ORDER BY\n",
        "  pct_diabetes DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "b478d789",
      "displayName": "fraud_risk_summary",
      "queryLines": [
        "SELECT * FROM main.healthcare_claims_util.gold_fraud_risk_summary"
      ]
    },
    {
      "name": "464dc5c4",
      "displayName": "provider_utilization_summary",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  main.healthcare_claims_util.gold_provider_utilization_summary\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN claim_type = 'Inpatient' THEN 1\n",
        "    ELSE 2\n",
        "  END"
      ]
    },
    {
      "name": "6534cf3b",
      "displayName": "Chronic Disease Prevalence (Top 15 States)",
      "queryLines": [
        "WITH top_states AS (\n",
        "  SELECT\n",
        "    *\n",
        "  FROM\n",
        "    main.healthcare_claims_util.gold_chronic_disease_prevalence\n",
        "  ORDER BY\n",
        "    (pct_diabetes + pct_heart_failure + pct_kidney_disease + pct_cancer) DESC\n",
        "  LIMIT 15\n",
        ")\n",
        "SELECT\n",
        "  state_name,\n",
        "  total_beneficiaries,\n",
        "  condition,\n",
        "  prevalence_pct\n",
        "FROM\n",
        "  top_states\n",
        "    UNPIVOT (\n",
        "      prevalence_pct FOR condition IN (\n",
        "        pct_diabetes AS `Diabetes`,\n",
        "        pct_heart_failure AS `Heart failure`,\n",
        "        pct_kidney_disease AS `Kidney disease`,\n",
        "        pct_cancer AS `Cancer`\n",
        "      )\n",
        "    )"
      ]
    }
  ],
