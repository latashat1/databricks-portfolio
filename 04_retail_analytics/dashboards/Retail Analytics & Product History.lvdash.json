    {
      "name": "fb824e40",
      "displayName": "price_history_impact",
      "queryLines": [
        "SELECT * FROM main.retail_analytics.gold_price_history_impact"
      ]
    },
    {
      "name": "price_history_impact",
      "displayName": "Price History Impact",
      "queryLines": [
        "SELECT\n",
        "  product_name,\n",
        "  'Correct (Point-in-Time)' AS metric_type,\n",
        "  correct_point_in_time_revenue AS revenue,\n",
        "  FALSE AS is_no_data\n",
        "FROM\n",
        "  main.retail_analytics.gold_price_history_impact\n",
        "UNION ALL\n",
        "SELECT\n",
        "  product_name,\n",
        "  'Naive (Current Price)' AS metric_type,\n",
        "  COALESCE(naive_current_price_revenue, 0) AS revenue,\n",
        "  CASE\n",
        "    WHEN naive_current_price_revenue IS NULL THEN TRUE\n",
        "    ELSE FALSE\n",
        "  END AS is_no_data\n",
        "FROM\n",
        "  main.retail_analytics.gold_price_history_impact"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "Top 20 Customers",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  city,\n",
        "  total_transactions,\n",
        "  total_spent\n",
        "FROM\n",
        "  main.retail_analytics.gold_customer_summary\n",
        "ORDER BY\n",
        "  total_spent DESC\n",
        "LIMIT 20"
      ]
    }
  ],
